shape: sequence_diagram

Client -> Client: "queue in the persistent outbox,\nstamp one HLC per batch"
Client -> Server: "POST /sync/patches (Bearer token)"
Server -> Redis: "run applyBatch.lua"
Redis -> Redis: "accept/reject each patch:\ntombstone check, structural write-once,\nper-field HLC last-write-wins, set merge"
Redis -> Redis: "apply accepted patches,\nINCR seq, XADD to the vault stream"
Redis -> Server: "accepted, seq, accepted/submitted counts"
Server -> Client: "200 (or 409 if nothing was accepted)"
Client -> Client: "drop from the outbox;\nwarn if any patch was dropped"
Redis -> "Other client": "live fanout over SSE"
Materializer -> Redis: "XREADGROUP (consumer group)"
Materializer -> Neo4j: "upsert / tombstone, then XACK"
