# Copy this file to .env.local for the optional remote-sync development stack.
# .env.local is ignored by Git; never commit a real credential.
NEO4J_PASSWORD=replace-with-your-local-neo4j-password

# Optional overrides:
# NEO4J_URL=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j
# VITE_PORT=5173
