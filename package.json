{
  "name": "@ng-org/meta-ui-builder-react",
  "version": "0.1.0",
  "private": true,
  "authors": [
    "Laurin Weger"
  ],
  "license": "MIT/Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "pnpm test:client && pnpm test:server",
    "test:client": "playwright test",
    "test:server": "tsx --test server/test/**/*.test.ts",
    "build:orm": "rdf-orm build --input ./src/shapes/shex --output ./src/shapes/orm",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:materializer": "ROLE=materializer tsx watch server/src/index.ts",
    "build:server": "tsc -p server/tsconfig.json && mkdir -p server-dist/redis && cp server/src/redis/applyBatch.lua server-dist/redis/applyBatch.lua",
    "start:server": "node server-dist/index.js",
    "start:materializer": "ROLE=materializer node server-dist/index.js"
  },
  "dependencies": {
    "@ng-org/orm": "0.1.2-alpha.14",
    "@tanstack/react-router": "^1.170.18",
    "ioredis": "^6.0.0",
    "neo4j-driver": "^6.2.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@ng-org/shex-orm": "0.1.2-alpha.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "^5.1.4",
    "tsx": "^4.23.1",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
