# Copy to deploy/.env and fill in. Never commit the result.

# Required. Also becomes the Neo4j password inside the stack.
NEO4J_PASSWORD=change-me-to-a-long-random-value

# Operator credential for GET /sync/admin/vaults. Leave empty and that route
# answers 404 - the right default until there is an operator to serve.
# Never reuse a vault token here; it reads every tenant's numbers.
ADMIN_TOKEN=

# Where the tunnel or reverse proxy should point.
SYNC_PORT=3000

# Sizing. Raise when the numbers say to, not before.
# The container limit must sit well above heap + page cache: the JVM's
# metaspace and thread stacks live above both, and 512m + 256m measured
# 833 MiB resident while idle.
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m
NEO4J_MEMORY_LIMIT=1500M
REDIS_MAXMEMORY=1gb

# Per-vault limits, enforced server-side against modified clients.
VAULT_QUOTA_BYTES=8388608
VAULT_CREATE_RATE_LIMIT=10
VAULT_WRITE_RATE_LIMIT=600

# One materializer is enough until materialization lag says otherwise.
MATERIALIZER_SHARD_COUNT=1
MATERIALIZER_SHARD_INDEX=0
